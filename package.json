{
  "name": "nearby-places",
  "version": "0.2.4",
  "private": true,
  "description": "Cordova prototype for offline places and foreground GPS",
  "scripts": {
    "test": "node tests/collections-model.test.js && node tests/collections-ui.test.js && node tests/navigation.test.js && node tests/catalogue.test.js && node tests/proximity.behavior.test.js && node tests/map-import.behavior.test.js && node tests/share-extension.patch.test.js",
    "ios:add": "cordova platform add ios@8.1.1",
    "ios:prepare": "node scripts/sync-ui-assets.js && cordova prepare ios",
    "ios:build": "npm run ios:prepare && npm run ios:verify && cordova build ios --debug",
    "ios:verify": "node tests/ios-generated.test.js",
    "ios:requirements": "cordova requirements ios",
    "postinstall": "node scripts/sync-ui-assets.js"
  },
  "devDependencies": {
    "cordova": "13.0.0",
    "cordova-background-geolocation-lt": "5.5.1",
    "cordova-ios": "8.1.1",
    "cordova-plugin-customurlscheme": "5.0.2",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-geolocation": "5.0.0",
    "cordova-plugin-local-notification": "1.2.3",
    "plist": "3.1.1",
    "xcode": "3.0.1",
    "bootswatch": "5.3.8",
    "@fortawesome/fontawesome-free": "7.3.1",
    "bootbox": "6.0.4",
    "jquery": "3.7.1",
    "bootstrap": "5.3.8"
  },
  "cordova": {
    "platforms": [
      "ios"
    ],
    "plugins": {
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-background-geolocation-lt": {
        "BACKGROUND_MODE_LOCATION": "<string>location</string>"
      },
      "cordova-plugin-local-notification": {},
      "cordova-plugin-customurlscheme": {
        "URL_SCHEME": "nearbyplaces"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-nearby-resolver": {}
    }
  },
  "dependencies": {
    "cordova-plugin-nearby-resolver": "file:local-plugins/cordova-plugin-nearby-resolver"
  }
}
