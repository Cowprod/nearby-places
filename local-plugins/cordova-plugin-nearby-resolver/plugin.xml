<?xml version="1.0" encoding="utf-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-nearby-resolver" version="0.1.0">
 <name>NearbyResolver</name>
 <hook type="after_prepare" src="hooks/afterPrepare.js"/>
 <js-module src="www/resolver.js" name="NearbyResolver"><clobbers target="NearbyResolver"/></js-module>
 <platform name="ios">
  <config-file target="config.xml" parent="/*"><feature name="NearbyResolver"><param name="ios-package" value="NearbyResolver"/></feature></config-file>
  <source-file src="src/ios/NearbyResolver.m"/>
  <header-file src="src/ios/NearbyMapsResolver.h"/>
  <header-file src="src/ios/NearbyPlacePicker.h"/>
  <framework src="MapKit.framework"/>
 </platform>
</plugin>
