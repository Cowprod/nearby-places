<?xml version="1.0" encoding="utf-8"?>
<widget id="fr.cowprod.nearbyplaces" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Nearby Places</name>
  <description>Personal place discovery and proximity reminders</description>
  <author>Cowprod</author>
  <content src="index.html"/>
  <access origin="*"/>
  <allow-intent href="https://*/*"/>
  <preference name="Orientation" value="default"/>
  <platform name="ios"><preference name="deployment-target" value="15.0"/></platform>
</widget>
